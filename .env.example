# --- Frontend (Vite) -------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of admin emails
VITE_ADMIN_EMAILS=admin@example.com,admin2@example.com

# --- Termux / Windows agent (optional, can also live in termux-agent/orion-config.sh)
ORION_SUPABASE_URL=https://your-project-ref.supabase.co
ORION_ANON_KEY=your-anon-key
